# AI-generated with Claude Code from a human-approved spec and plan; each task independently AI-reviewed; integrated and verified by Lionel Derrick Roxas.
# ── Required ──────────────────────────────────────────────────────────────────
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=

# ── Optional (the values below are the defaults) ─────────────────────────────
# Model (openai/gpt-oss-20b is cheaper and weaker)
GROQ_MODEL=openai/gpt-oss-120b
# Reasoning effort per role: medium or low are the practical choices. high is accepted but was too slow
# (a Fixer call was still waiting after ~114 s, against 9 s for a medium Writer call).
GROQ_WRITER_REASONING_EFFORT=medium
GROQ_FIXER_REASONING_EFFORT=medium
# Host ports. Change them if they are taken, then run `make up` again (the frontend bakes the API URL at build time).
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Host folder whose Go modules (up to two levels deep) appear under "Your folders". Absolute path or relative to
# this repo (compose does not expand ~), then run `make up` again. Examples:
#   Windows: C:\Users\you\code    macOS: /Users/you/code    Linux: /home/you/code
HOST_REPOS_DIR=./repos

# ── Free-trial Groq key (8K tokens/min, 200K tokens/day): uncomment all three ──
# The app's own daily token cap (default 2000000); not a Groq setting
# DAILY_TOKEN_BUDGET=190000
# Prompt-size cap per call (default 12000)
# MAX_PROMPT_TOKENS=4500
# Tokens reserved per call for pacing (default 16000)
# CALL_TOKEN_RESERVATION=8000

# ── Advanced (rarely needed) ──────────────────────────────────────────────────
# Output-token cap per call. 65536 (the default) is the model maximum. Leaving it empty does NOT mean
# unlimited: Groq then applies a smaller default that truncates long answers.
# GROQ_MAX_COMPLETION_TOKENS=65536
# Seconds one Groq request may take before the item fails with "Groq did not answer within 240 s"
# GROQ_TIMEOUT_S=240
