# Required: create a free key at https://console.groq.com/keys
GROQ_API_KEY=
# Model the app requires (fallback: openai/gpt-oss-20b — cheaper, weaker)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
# Host ports for the app (change these if the defaults are taken on your machine)
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Optional cap on output tokens (unset = model maximum)
# GROQ_MAX_COMPLETION_TOKENS=4000
# Tokens reserved per call for pacing; lower = more calls/min within your TPM limit
# CALL_TOKEN_RESERVATION=5000
# Groq's base limits for openai/gpt-oss-120b are 8K tokens/min and 200K tokens/day:
# set DAILY_TOKEN_BUDGET=190000 unless your org has higher limits (default 2,000,000 assumes a paid plan)
# DAILY_TOKEN_BUDGET=190000
# Absolute host path whose sub-folders contain Go repos (compose does not expand ~)
HOST_REPOS_DIR=./repos
