# AI-generated with Claude Code from a human-approved spec and plan; each task independently AI-reviewed; integrated and verified by Lionel Derrick Roxas.
# Required: create a free key at https://console.groq.com/keys
GROQ_API_KEY=
# Model the app requires (fallback: openai/gpt-oss-20b — cheaper, weaker)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
# Host ports for the app (change these if the defaults are taken on your machine; changing them requires `docker compose up --build`, since the frontend bakes the API URL at build time)
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Output tokens per call. 65536 is the model maximum for openai/gpt-oss-120b on Groq. Empty omits the field, which does NOT mean unlimited: Groq then applies a smaller undocumented default that truncates long answers.
# GROQ_MAX_COMPLETION_TOKENS=65536
# Tokens reserved per call for pacing and the daily-ledger check (default 16000). For accurate pacing keep it
# >= MAX_PROMPT_TOKENS plus the expected answer; lower = more calls/min, occasional short 429 waits are retried automatically.
# CALL_TOKEN_RESERVATION=16000
# Groq's base limits for openai/gpt-oss-120b are 8K tokens/min and 200K tokens/day:
# set DAILY_TOKEN_BUDGET=190000 unless your org has higher limits (default 2,000,000 assumes a paid plan)
# DAILY_TOKEN_BUDGET=190000
# Estimated prompt-size cap per call (default 12000). Free-trial keys (8K tokens/min) should set 4500,
# so a prompt plus its answer fits in one minute's allowance, and CALL_TOKEN_RESERVATION=8000 (one minute's allowance).
# MAX_PROMPT_TOKENS=4500
# CALL_TOKEN_RESERVATION=8000
# Host folder mounted as ./repos in the app; Go modules up to two levels deep appear under "Your folders".
# Use an absolute path (compose does not expand ~) or one relative to this repo, then run `make up` again.
#   Windows: HOST_REPOS_DIR=C:\Users\you\code
#   macOS:   HOST_REPOS_DIR=/Users/you/code
#   Linux:   HOST_REPOS_DIR=/home/you/code
HOST_REPOS_DIR=./repos
