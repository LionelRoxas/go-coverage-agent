# AI-generated with Claude Code from a human-approved spec and plan; each task independently AI-reviewed; integrated and verified by Lionel Derrick Roxas.
# ── Required ──────────────────────────────────────────────────────────────────
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=

# ── Optional (the values below are the defaults unless noted) ────────────────
# Model (openai/gpt-oss-20b is cheaper and weaker)
GROQ_MODEL=openai/gpt-oss-120b
# Reasoning effort per role: medium or low are the practical choices. high is accepted but was too slow
# (a Fixer call was still waiting after ~114 s, against 9 s for a medium Writer call).
GROQ_WRITER_REASONING_EFFORT=medium
GROQ_FIXER_REASONING_EFFORT=medium
# Host ports. Change them if they are taken, then run `make up` again (the frontend bakes the API URL at build time).
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Your own Go projects: the Go modules (up to two levels deep) in this host folder appear under "Your folders".
# It is mounted READ-ONLY (each run works on a copy). Absolute path or relative to this repo (compose does not
# expand ~), then run `make up` again. Keep it separate from ./repos, which holds samples and uploads. Examples:
#   Windows: C:\Users\you\code    macOS: /Users/you/code    Linux: /home/you/code
HOST_REPOS_DIR=./my-repos
# The app's own daily token cap (not a Groq limit), counted in output/.usage.json, resets at midnight UTC.
DAILY_TOKEN_BUDGET=2000000
# Groq prices in USD per 1M input / output tokens, for the estimated cost in the end-of-run summary. Not defaults
# (unset, no cost is shown): example prices for openai/gpt-oss-120b on Groq at the time of writing; check
# console.groq.com pricing. Remove both lines to hide the cost.
GROQ_PRICE_INPUT_PER_M=0.15
GROQ_PRICE_OUTPUT_PER_M=0.60

# ── Free-trial Groq key (8K tokens/min, 200K tokens/day): uncomment all three ──
# Daily token cap for a free-trial key
# DAILY_TOKEN_BUDGET=190000
# Prompt-size cap per call (default 12000)
# MAX_PROMPT_TOKENS=4500
# Tokens reserved per call for pacing (default 16000)
# CALL_TOKEN_RESERVATION=8000

# ── Advanced (rarely needed) ──────────────────────────────────────────────────
# Output-token cap per call. 65536 (the default) is the model maximum. Leaving it empty does NOT mean
# unlimited: Groq then applies a smaller default that truncates long answers.
# GROQ_MAX_COMPLETION_TOKENS=65536
# Seconds one Groq request may take. A timed-out request is retried once at low reasoning effort; a second
# timeout fails the item with "Groq did not answer within 240 s, twice"
# GROQ_TIMEOUT_S=240
# Seconds Groq may stay unreachable (timeouts, 5xx, connection errors in a row) before the run stops with
# llm_unavailable; until then the affected items are retried later with backoff
# LLM_UNAVAILABLE_AFTER_S=600
# Folder uploads (Your folders > Choose a folder…), counted after skipping .git, vendor, node_modules, hidden and
# binary files: at most this many files and bytes in total; single files over UPLOAD_MAX_FILE_BYTES are skipped
# UPLOAD_MAX_FILES=3000
# UPLOAD_MAX_BYTES=26214400
# UPLOAD_MAX_FILE_BYTES=1048576
# Run history: how many of the most recent runs in ./output are reloaded when the app starts
# HISTORY_MAX_RUNS=500
